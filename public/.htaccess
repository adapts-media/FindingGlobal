# --- CPANEL NODE.JS SELECTOR RULES (Keep whatever cPanel generated here) ---
# (Do not delete any Passenger/Node rules that cPanel automatically put at the top)

# --- HTTP TO HTTPS 301 REDIRECTS & REACT SPA ROUTER RULES ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. FORCE HTTPS: Redirect any HTTP request to HTTPS (301 Moved Permanently)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
  RewriteRule ^(.*)$ https://findingglobal.com/$1 [R=301,L]

  # 2. FORCE NON-WWW: Redirect www.findingglobal.com to findingglobal.com
  RewriteCond %{HTTP_HOST} ^www\.findingglobal\.com$ [NC]
  RewriteRule ^(.*)$ https://findingglobal.com/$1 [R=301,L]

  # 3. REACT SPA ROUTER FALLBACK
  RewriteRule ^index\.html$ - [L]
  
  # EXCLUDE backend API from SPA redirect
  RewriteCond %{REQUEST_URI} !^/api [NC]
  
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- SECURITY & SEO HEADERS ---
<IfModule mod_headers.c>
  # Strict-Transport-Security (HSTS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

