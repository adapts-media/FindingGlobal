# Copy to /opt/findingglobal/shared/server.env on the VPS and fill in real values.
# This file is the ONLY place production secrets live — it is never committed to git and never
# uploaded by the deploy workflow. Lock it down: chmod 600, owned by the deploy user.
NODE_ENV=production
PORT=4100

MONGODB_URI=
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://findingglobal.com
FRONTEND_URL=https://findingglobal.com

GOOGLE_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ZIINA_TOKEN=
